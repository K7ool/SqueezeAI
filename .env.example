# Squeeze Environment Configuration Template
# Copy this file to .env or upload into Vercel / Cloud Run environment variables

# [AI Engine]
# GEMINI_API_KEY: Required for default high-performance AI Luau generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=AIzaSyDyYcFavA5-PDOGZ6ugcs3l8Gt2T60PIj0

# ANTHROPIC_API_KEY: Optional alternative Claude backend if configured.
ANTHROPIC_API_KEY=

# [Application URLs]
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
VERCEL_URL=https://squeezeai.vercel.app/

# [Authentication & Security]
# Secret for signing session tokens and user credentials
