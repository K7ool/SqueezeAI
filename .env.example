# Squeeze Environment Configuration

# GEMINI_API_KEY: Required for default high-performance AI Luau generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional alternative Claude backend if configured.
ANTHROPIC_API_KEY="sk-ant-api03-..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (for Supabase / Neon / Local Postgres production deployment)
# e.g., postgresql://postgres:password@localhost:5432/squeeze?schema=public
DATABASE_URL="postgresql://postgres:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/squeezedb?sslmode=require"

# JWT_SECRET / NEXTAUTH_SECRET: Secret for signing session tokens and user credentials
JWT_SECRET="squeeze-super-secret-production-jwt-key-change-me"
NEXTAUTH_SECRET="squeeze-super-secret-production-jwt-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# STRIPE CONFIGURATION: For real subscription checkout and billing portal
STRIPE_SECRET_KEY="sk_test_51Nx..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_1N..."
STRIPE_PRICE_STUDIO_MONTHLY="price_1N..."

# EMAIL PROVIDER: Resend or Nodemailer for confirmation & welcome emails
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Squeeze <hello@squeeze.gg>"

