// Prisma Schema for Squeeze (Roblox AI Luau Generator)
// Supports PostgreSQL (Supabase, Neon, AWS RDS, Railway, Render)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum ScriptType {
  SERVER
  CLIENT
  MODULE
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  passwordHash     String?
  avatar           String?
  role             String            @default("user") // "user" | "admin"
  
  // Plan & Quota Tracking
  plan             PlanTier          @default(FREE)
  monthlyLimit     Int               @default(25)     // Free = 25, Pro = 500/unlimited, Studio = unlimited
  usedGenerations  Int               @default(0)
  quotaResetDate   DateTime          @default(now())
  
  // Stripe Customer
  stripeCustomerId String?           @unique
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // Relations
  subscription     Subscription?
  scripts          GeneratedScript[]
  apiKeys          ApiKey[]

  @@map("users")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  plan                 PlanTier           @default(FREE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model GeneratedScript {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  title          String
  prompt         String      @db.Text
  code           String      @db.Text
  explanation    String?     @db.Text
  scriptType     ScriptType  @default(SERVER)
  targetInstance String      @default("ServerScriptService") // Where to put in Explorer
  lineCount      Int         @default(0)
  tags           String[]    @default([])
  isFavorite     Boolean     @default(false)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("generated_scripts")
}

model EmailSubscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  status      SubscriberStatus @default(ACTIVE)
  confirmedAt DateTime?        @default(now())
  source      String           @default("landing_footer")
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("email_subscribers")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Studio Plugin Key")
  keyHash   String   @unique
  prefix    String   // e.g. "sqz_live_..."
  lastUsedAt DateTime?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("api_keys")
}

model StudioSession {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userId         String?
  projectId      String
  projectName    String   @default("Roblox Game")
  placeId        BigInt?
  placeName      String?
  universeId     BigInt?
  pairingCode    String
  token          String   @unique
  status         String   @default("pending_pairing") // pending_pairing, connected, offline, disconnected
  connectedAt    DateTime?
  lastHeartbeat  DateTime @default(now())
  pluginVersion  String   @default("2.5.0")
  clientIp       String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([token])
  @@map("studio_sessions")
}

model StudioChangeEvent {
  id           String   @id @default(cuid())
  changeId     String   @unique
  projectId    String
  sessionId    String?
  fileId       String
  path         String
  className    String   @default("Script")
  action       String   @default("update") // create, update, delete, rename, move
  source       String   @db.Text
  version      Int      @default(1)
  hash         String
  author       String   @default("website") // website, studio, ai
  status       String   @default("pending") // pending, applied, acknowledged, conflict, failed
  errorMessage String?

  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([status])
  @@map("studio_change_events")
}

model StudioFileVersion {
  id         String   @id @default(cuid())
  projectId  String
  path       String
  name       String
  className  String   @default("Script")
  parentPath String   @default("ServerScriptService")
  source     String   @db.Text
  version    Int      @default(1)
  hash       String
  updatedBy  String   @default("website")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
  @@map("studio_file_versions")
}

model StudioConflict {
  id               String   @id @default(cuid())
  conflictId       String   @unique
  projectId        String
  fileId           String
  path             String
  websiteVersion   Int
  websiteSource    String   @db.Text
  websiteUpdatedAt DateTime
  studioVersion    Int
  studioSource     String   @db.Text
  studioUpdatedAt  DateTime
  detectedAt       DateTime @default(now())
  status           String   @default("open") // open, resolved
  resolution       String?  // keep_website, keep_studio, manual_merge
  resolvedAt       DateTime?

  @@index([projectId])
  @@index([status])
  @@map("studio_conflicts")
}

